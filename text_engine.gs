list char_index "assets/data/char_index.txt";
list char_width "assets/data/char_width.txt";
list font_data "assets/data/font_data.txt";

on "init_constants" {
    erase_all;
    hide;
    switch_costume " ";
    set_size 108000;
    switch_costume "a";
    set_color 0, 0, 0, 0;
}

on "display_text" {
    set_color 255, 255, 255, 255;
    print 232.5, -173, size: 12, text: COLLECTED_GOO & "/" & TARGET_GOO & " goo collected", al_x: "r", weight: 3;
    set_color 0, 0, 0, 0;
    print 233, -173, size: 12, text: COLLECTED_GOO & "/" & TARGET_GOO & " goo collected", al_x: "r";
}

proc internal__printchar index, x, y, i_x, i_y, j_x, j_y {
    x2 += $i_x * char_width[$index];
    y2 += $i_y * char_width[$index];
    i3 = char_index[$index];
    repeat font_data[i3 - 1] {
        goto $x + ($i_x * font_data[i3] + $j_x * font_data[i3 + 1]), $y + ($i_y * font_data[i3] + $j_y * font_data[i3 + 1]);
        pen_down;
        i3 += 3;
        repeat font_data[i3 - 1] {
            goto $x + ($i_x * font_data[i3] + $j_x * font_data[i3 + 1]), $y + ($i_y * font_data[i3] + $j_y * font_data[i3 + 1]);
            i3 += 2;
        }
        pen_up;
    }
    i3 += 1;
    change_pen_size 1;
    repeat font_data[i3 - 1] {
        goto $x + ($i_x * font_data[i3] + $j_x * font_data[i3 + 1]), $y + ($i_y * font_data[i3] + $j_y * font_data[i3 + 1]);
        pen_down;
        pen_up;
        i3 += 2;
    }
    change_pen_size -1;
}

proc set_color r="", g="", b="", a="" {
    set_pen_color round($b) + 256 * (round($g) + 256 * (round($r) + 256 * round($a)));
}

proc print x, y, size="", i_x="", i_y="", j_x="", j_y="", cspace="", weight="", ul_left="", ul_right="", ul_weight="", al_x="", al_y="", text="" {
    pen_up;
    i0 = (($size == "") * 12 + $size) / 100;
    set_pen_size 0.125 * ((($weight == "") + $weight) * (100 * i0));
    i1 = i0 * (($i_x == "") + $i_x);
    i2 = i0 * (1 * $i_y);
    i3 = ($cspace == "") + $cspace;
    internal__printtext $text, 1 * $x, 1 * $y, i1, i2, i0 * (1 * $j_x), i0 * (($j_y == "") + $j_y), 30 * (i3 * i1), 30 * (i3 * i2), $ul_left, $ul_right, 0.125 * ((($ul_weight == "") + $ul_weight) * (100 * i0)), -1 * (($al_x == "r") + ($al_x == "c") * 0.5 + $al_x), -1 * (($al_y == "t") + ($al_y == "c") * 0.5 + $al_y);
}

proc internal__printtext text, x, y, i_x, i_y, j_x, j_y, cs_x, cs_y, ul_left, ul_right, ul_weight, al_x, al_y {
    x2 = $x + 100 * ($al_y * $j_x);
    y2 = $y + 100 * ($al_y * $j_y);
    if not ($al_x == 0) {
        i0 = 1;
        i1 = 0;
        i2 = 0;
        repeat length($text) {
            switch_costume " ";
            switch_costume $text[i0];
            i1 += $i_x * char_width[costume_number()] + $cs_x;
            i2 += $i_y * char_width[costume_number()] + $cs_y;
            i0 += 1;
        }
        x2 += $al_x * (i1 - $cs_x);
        y2 += $al_x * (i2 - $cs_y);
    }
    i1 = x2 + (100 * ($ul_left * $j_x) - 0.3 * $cs_x);
    i2 = y2 + (100 * ($ul_left * $j_y) - 0.3 * $cs_y);
    i0 = 1;
    repeat length($text) {
        switch_costume " ";
        switch_costume $text[i0];
        internal__printchar costume_number(), x2, y2, $i_x, $i_y, $j_x, $j_y;
        x2 += $cs_x;
        y2 += $cs_y;
        i0 += 1;
    }
    if not ($ul_left == "" or $ul_right == "") {
        set_pen_size $ul_weight;
        goto x2 + (100 * ($ul_right * $j_x) - 0.7 * $cs_x), y2 + (100 * ($ul_right * $j_y) - 0.7 * $cs_y);
        pen_down;
        goto i1, i2;
        pen_up;
    }
}
